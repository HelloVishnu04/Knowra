# Database
DATABASE_URL="postgresql://user:password@localhost:5432/omnirag"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="documents_kb_phase3"
EMBEDDING_MODEL="embeddinggemma"
SPARSE_MODEL="Qdrant/bm25"
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_LIMIT=40
RERANKER_ENABLED=true
RERANKER_MODEL="BAAI/bge-reranker-base"
RERANKER_CANDIDATE_LIMIT=20
CHUNK_TOKENIZER="sentence-transformers/all-MiniLM-L6-v2"
OBJECT_STORE="local"
OBJECT_STORE_PATH="./data/objects"
LOCAL_WORKSPACE_ID="local-workspace"
# For OBJECT_STORE=s3: configure S3_BUCKET, S3_ENDPOINT_URL and standard AWS credentials.

# Auth
JWT_SECRET="changeme"
JWT_ALGORITHM="HS256"

# LLM Providers (Leave blank to use local Ollama by default)
# Compose reaches a host Ollama process through Docker Desktop's host gateway.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Workspace / API Limits
DEFAULT_ROW_LIMIT=100
STATEMENT_TIMEOUT_MS=10000

# Sandbox (Docker)
SANDBOX_IMAGE="python:3.11-slim"
