# Database
DATABASE_URL="postgresql://user:password@localhost:5432/omnirag"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="documents_kb_phase3"
EMBEDDING_MODEL="embeddinggemma"
SPARSE_MODEL="Qdrant/bm25"
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_LIMIT=40
RERANKER_ENABLED=true
RERANKER_MODEL="BAAI/bge-reranker-base"
RERANKER_CANDIDATE_LIMIT=20
CHUNK_TOKENIZER="sentence-transformers/all-MiniLM-L6-v2"
OBJECT_STORE="local"
OBJECT_STORE_PATH="./data/objects"
LOCAL_WORKSPACE_ID="local-workspace"
LANGGRAPH_CHECKPOINTER="redis"
AGENT_TOP_K=8
# For OBJECT_STORE=s3: configure S3_BUCKET, S3_ENDPOINT_URL and standard AWS credentials.

# Auth
JWT_SECRET="changeme"
JWT_ALGORITHM="HS256"

# LLM Providers (Leave blank to use local Ollama by default)
# Compose reaches a host Ollama process through Docker Desktop's host gateway.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Workspace / API Limits
DEFAULT_ROW_LIMIT=100
STATEMENT_TIMEOUT_MS=10000
SQL_DATABASE_URL="postgresql://knowra_reader:reader-password@localhost:5432/omnirag"
SQL_ALLOWED_TABLES="public.knowledge_bases,public.documents"
# Reads from these tables pause for explicit approval before execution.
SQL_SENSITIVE_TABLES="public.documents"

# Code repositories
CODE_REPOSITORY_PATH="./data/repositories"
# Local-path ingestion stays disabled until this points at an explicitly controlled root.
CODE_LOCAL_ROOT=""
CODE_GIT_ALLOWED_HOSTS="github.com,gitlab.com"
CODE_COLLECTION="code_symbols_phase6"
CODE_MAX_ARCHIVE_BYTES=52428800
CODE_MAX_EXTRACTED_BYTES=262144000
CODE_MAX_FILES=20000
CODE_MAX_SOURCE_BYTES=1048576

# Sandbox execution is consumed only by the dedicated queue:sandbox worker.
SANDBOX_EXECUTION_ENABLED=false
SANDBOX_QUEUE="queue:sandbox"
SANDBOX_PYTHON_IMAGE="knowra-sandbox-python:phase8"
SANDBOX_NODE_IMAGE="knowra-sandbox-node:phase8"
SANDBOX_WALL_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_PIDS_LIMIT=128
SANDBOX_SNAPSHOT_BYTES=10485760
SANDBOX_OUTPUT_BYTES=1048576
